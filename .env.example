# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://zawed:zawed@localhost:5432/zawed?schema=public"

# Secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Flat delivery fee in SDG, and the subtotal above which delivery is free.
DELIVERY_FEE="1000"
FREE_DELIVERY_OVER="20000"
