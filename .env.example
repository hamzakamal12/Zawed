# =====================================================================
# Zawed Supply — environment
#
# This app is a pure static SPA: every variable below is compiled into
# the bundle and is therefore PUBLIC. Never put a secret here.
#
# In particular there is NO service-role key. It bypasses every RLS
# policy, and in a client-only app any visitor could read it straight
# out of the JavaScript. The anon/publishable key is the correct one to
# ship — the database is protected by RLS, not by hiding this key.
# =====================================================================

# ── Supabase ──────────────────────────────────────────────────────────
# Project → Settings → API. Vite only exposes vars prefixed with VITE_.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"

# ── Business defaults ─────────────────────────────────────────────────
VITE_DEFAULT_VAT_PERCENT="0"        # Sudan VAT if applicable
VITE_QUOTE_VALIDITY_DAYS="7"

# ── Supplier letterhead printed on generated PDF documents ────────────
VITE_SUPPLIER_NAME="شركة النيل للتوريدات المكتبية المحدودة"
VITE_SUPPLIER_ADDRESS="الخرطوم — السودان"
VITE_SUPPLIER_PHONE="+249 183 000 000"
VITE_SUPPLIER_TAX_ID="TAX-SD-0000-000"
