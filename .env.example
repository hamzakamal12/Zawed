# ── Supabase (backend) ────────────────────────────────────────────────
# From your Supabase project → Settings → API
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server/Edge only — never ship to the client

# ── Frontend (Vite) ───────────────────────────────────────────────────
# Vite only exposes vars prefixed with VITE_
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# ── Business defaults ─────────────────────────────────────────────────
VITE_DEFAULT_VAT_PERCENT="0"        # Sudan VAT if applicable
VITE_QUOTE_VALIDITY_DAYS="7"

# ── Supplier letterhead printed on generated PDF documents ────────────
VITE_SUPPLIER_NAME="شركة النيل للتوريدات المكتبية المحدودة"
VITE_SUPPLIER_ADDRESS="الخرطوم — السودان"
VITE_SUPPLIER_PHONE="+249 183 000 000"
VITE_SUPPLIER_TAX_ID="TAX-SD-0000-000"
