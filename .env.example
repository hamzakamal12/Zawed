# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://zawed:zawed@localhost:5432/zawed?schema=public"

# Secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Tax rate applied to invoices (e.g. 0.05 for 5% VAT).
DEFAULT_TAX_RATE="0.05"

# Resend email service — get a free API key at https://resend.com
# Leave blank to disable automatic proforma invoice emails.
RESEND_API_KEY=""
EMAIL_FROM="Zawed Invoices <invoices@zawed.io>"
