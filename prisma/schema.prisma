// Prisma schema for Zawed B2B procurement platform.
// Run `npx prisma migrate dev` after editing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STAFF
  MANAGER
  ADMIN
}

enum CartStatus {
  ACTIVE
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CHECKED_OUT
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
}

enum SubscriptionFrequency {
  WEEKLY
  MONTHLY
}

model Company {
  id            String         @id @default(cuid())
  name          String
  address       String?
  taxId         String?
  phone         String?
  email         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  carts         Cart[]
  orders        Order[]
  subscriptions Subscription[]
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  name            String
  passwordHash    String
  role            Role           @default(STAFF)
  companyId       String?
  company         Company?       @relation(fields: [companyId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  carts           Cart[]         @relation("CartOwner")
  reviewedCarts   Cart[]         @relation("CartReviewer")
  placedOrders    Order[]        @relation("OrderPlacer")
  subscriptions   Subscription[] @relation("SubscriptionOwner")

  @@index([companyId])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id                 String             @id @default(cuid())
  sku                String             @unique
  name               String
  description        String?
  imageUrl           String?
  categoryId         String
  category           Category           @relation(fields: [categoryId], references: [id])
  stock              Int                @default(0)
  lowStockThreshold  Int                @default(10)
  taxRate            Decimal            @default(0.05) @db.Decimal(5, 4)
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  priceTiers         PriceTier[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  subscriptionItems  SubscriptionItem[]

  @@index([categoryId])
  @@index([active])
}

// A tiered price break. minQty is inclusive; maxQty is inclusive (null = no upper bound).
model PriceTier {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty    Int
  maxQty    Int?
  unitPrice Decimal @db.Decimal(12, 2)

  @@unique([productId, minQty])
  @@index([productId])
}

model Cart {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation("CartOwner", fields: [userId], references: [id])
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  status       CartStatus @default(ACTIVE)
  notes        String?
  submittedAt  DateTime?
  reviewedById String?
  reviewedBy   User?      @relation("CartReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  rejectionReason String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        CartItem[]

  @@index([userId, status])
  @@index([companyId, status])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  notes     String?

  @@unique([cartId, productId])
  @@index([cartId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id])
  placedById    String
  placedBy      User        @relation("OrderPlacer", fields: [placedById], references: [id])
  status        OrderStatus @default(PENDING_PAYMENT)
  subtotal      Decimal     @db.Decimal(12, 2)
  taxAmount     Decimal     @db.Decimal(12, 2)
  totalAmount   Decimal     @db.Decimal(12, 2)
  paymentMethod String      @default("CASH_ON_DELIVERY")
  notes         String?
  createdAt     DateTime    @default(now())
  paidAt        DateTime?
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]

  @@index([companyId])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  productSku  String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @db.Decimal(5, 4)
  subtotal    Decimal @db.Decimal(12, 2)

  @@index([orderId])
}

model Subscription {
  id          String                @id @default(cuid())
  companyId   String
  company     Company               @relation(fields: [companyId], references: [id])
  createdById String
  createdBy   User                  @relation("SubscriptionOwner", fields: [createdById], references: [id])
  name        String
  frequency   SubscriptionFrequency
  active      Boolean               @default(true)
  nextRunAt   DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  items       SubscriptionItem[]

  @@index([companyId, active])
}

model SubscriptionItem {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Int

  @@unique([subscriptionId, productId])
}
