// Prisma schema for Zawed Beauty — B2C cosmetics store (Sudan).
// Run `npx prisma migrate dev` after editing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
}

enum OrderStatus {
  PENDING_PAYMENT // بانتظار الدفع عند الاستلام
  CONFIRMED       // تم تأكيد الطلب / قيد التوصيل
  DELIVERED       // تم التوصيل والدفع
  CANCELLED       // ملغي
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  city         String?
  address      String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  carts        Cart[]   @relation("CartOwner")
  orders       Order[]  @relation("OrderPlacer")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  emoji       String?
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id                String      @id @default(cuid())
  sku               String      @unique
  name              String
  brand             String?
  description       String?
  imageUrl          String?
  categoryId        String
  category          Category    @relation(fields: [categoryId], references: [id])
  stock             Int         @default(0)
  lowStockThreshold Int         @default(5)
  taxRate           Decimal     @default(0) @db.Decimal(5, 4)
  active            Boolean     @default(true)
  featured          Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  priceTiers        PriceTier[]
  cartItems         CartItem[]
  orderItems        OrderItem[]

  @@index([categoryId])
  @@index([active])
}

// A price break. minQty is inclusive; maxQty is inclusive (null = no upper bound).
// A retail product normally has a single tier (minQty = 1). Extra tiers enable
// optional wholesale/bulk discounts.
model PriceTier {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty    Int
  maxQty    Int?
  unitPrice Decimal @db.Decimal(12, 2)

  @@unique([productId, minQty])
  @@index([productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation("CartOwner", fields: [userId], references: [id])
  status    CartStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@index([userId, status])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  notes     String?

  @@unique([cartId, productId])
  @@index([cartId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  placedById    String
  placedBy      User        @relation("OrderPlacer", fields: [placedById], references: [id])
  status        OrderStatus @default(PENDING_PAYMENT)
  // Shipping / delivery details captured at checkout.
  customerName  String
  customerPhone String
  shippingCity  String
  shippingAddress String
  subtotal      Decimal     @db.Decimal(12, 2)
  taxAmount     Decimal     @db.Decimal(12, 2)
  deliveryFee   Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal     @db.Decimal(12, 2)
  paymentMethod String      @default("CASH_ON_DELIVERY")
  notes         String?
  createdAt     DateTime    @default(now())
  paidAt        DateTime?
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]

  @@index([placedById])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  productSku  String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @db.Decimal(5, 4)
  subtotal    Decimal @db.Decimal(12, 2)

  @@index([orderId])
}
